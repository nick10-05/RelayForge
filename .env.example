# Copy to .env (untracked):  Copy-Item .env.example .env
# Real credentials (e.g. Neon) go only in .env, never in this file.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# App connection. In production: Neon's *pooled* URL.
DATABASE_URL=postgres://relayforge:relayforge@localhost:5433/relayforge_dev
# Migrations. In production: Neon's *direct* URL. Locally the same as DATABASE_URL.
DATABASE_DIRECT_URL=postgres://relayforge:relayforge@localhost:5433/relayforge_dev
# Integration tests only.
TEST_DATABASE_URL=postgres://relayforge:relayforge@localhost:5433/relayforge_test

# Dev only: allow destinations on localhost/private networks (e.g. a local test receiver).
# Refused when NODE_ENV=production.
ALLOW_PRIVATE_DESTINATIONS=false

# Secret encryption keyring (AES-256-GCM, design §7.4). Required (except in tests).
# Format: "<keyId>:<base64 32 bytes>", comma-separated; the active key seals new values,
# the others only open old ones. Generate a key (PowerShell or any shell):
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real key. Rotate: add the new key first, switch the active id, keep the old.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# Browser origins allowed to make state-changing API calls (CSRF check). Comma-separated.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 outside production; required in production.
# APP_ORIGIN=https://relayforge.example.com

# Abuse limits (defaults shown). Per endpoint, in memory (single instance).
# INGEST_RATE_PER_SECOND=20
# INGEST_BURST=100
# INVALID_SIGNATURE_PER_MINUTE=10
# Storage guard: ingest answers 503 above 90% of this (Neon free tier = 0.5 GB).
# STORAGE_CAP_BYTES=536870912
